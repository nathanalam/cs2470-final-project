{
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(modal deploy*)",
      "Bash(modal token*)",
      "Bash(modal setup*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 20,
            "onFailure": "block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_checks.py\"",
            "timeout": 900,
            "statusMessage": "Running repo checks before stopping"
          }
        ]
      }
    ]
  }
}
